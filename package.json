{
  "name": "tailwindui-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "next dev 2>&1 | tee /tmp/next-dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run validate:mdx && npm run format:check && npm run lint && npm test && npm run build",
    "clean": "rm -rf .next .cache",
    "validate:mdx": "node scripts/validate-mdx.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,mdx,css}\"",
    "diagram": "d2",
    "diagram:blog:davison": "node scripts/generate-blog-diagram.mjs src/app/blog/davison-menswear/testing-pipeline.d2"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-glob": "^3.2.11",
    "feed": "^6.0.0",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-player": "^3.4.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.10",
    "@types/node": "^26.1.0",
    "@types/react": "19.2.17",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  }
}
