{
  "name": "tailwindui-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev 2>&1 | tee /tmp/next-dev.log",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run validate:mdx && npm run lint && npm test && npx next build",
    "clean": "rm -rf .next .cache",
    "validate:mdx": "node scripts/validate-mdx.js"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "@mapbox/rehype-prism": "^0.7.0",
    "@mdx-js/loader": "^2.3.0",
    "@mdx-js/react": "^2.3.0",
    "@next/mdx": "13.4.16",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^1.2.1",
    "date-fns": "^4.4.0",
    "fast-glob": "^3.2.11",
    "feed": "^4.2.2",
    "lucide-react": "^0.479.0",
    "next": "^15.1.6",
    "next-themes": "^0.2.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-player": "^2.13.0",
    "remark-gfm": "^3.0.1",
    "sharp": "^0.33.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.1.6",
    "@types/node": "22.13.9",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "8.45.0",
    "eslint-config-next": "13.4.16",
    "glob": "^11.0.1",
    "prettier": "^2.8.7",
    "prettier-plugin-tailwindcss": "^0.2.6",
    "typescript": "5.8.2",
    "vitest": "^4.1.9"
  }
}
