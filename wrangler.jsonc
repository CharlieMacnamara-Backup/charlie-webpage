{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charlie-webpage",
  "account_id": "935778ed373c03243b43103d32ed29bd",
  "main": ".cloudflare/worker.js",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    { "pattern": "charliemacnamara.uk", "custom_domain": true },
    { "pattern": "www.charliemacnamara.uk", "custom_domain": true }
  ]
}
