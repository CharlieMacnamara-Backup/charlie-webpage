{
  "presets": [
    [
      "next/babel",
      {
        "preset-env": {
          "modules": false
        }
      }
    ]
  ],
  "plugins": [
    ["transform-remove-console", { "exclude": ["error", "warn"] }],
    [
      "module-resolver",
      {
        "root": ["./"],
        "alias": {
          "@": "./src"
        }
      }
    ]
  ]
} 